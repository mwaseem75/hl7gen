{
  "manifest_version": "0.4",
  "name": "hl7gen",
  "version": "0.1.0",
  "description": "Generate, validate, and convert synthetic HL7 v2 test data — no vendor lock-in.",
  "author": {
    "name": "mwaseem75",
    "url": "https://github.com/mwaseem75/hl7gen"
  },
  "server": {
    "type": "uv",
    "entry_point": "src/hl7gen/mcp_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--extra", "mcp", "--directory", "${__dirname}", "src/hl7gen/mcp_server.py"],
      "env": {
        "ANTHROPIC_API_KEY": "${user_config.anthropic_api_key}"
      }
    }
  },
  "user_config": {
    "anthropic_api_key": {
      "type": "string",
      "title": "Anthropic API Key",
      "description": "Optional. Enables --realistic AI-generated patient data; without it, generation falls back to randomized test data automatically.",
      "sensitive": true,
      "required": false
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.9"
    }
  },
  "license": "MIT"
}
